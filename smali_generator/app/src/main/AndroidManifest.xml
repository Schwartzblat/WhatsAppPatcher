<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application tools:ignore="MissingApplicationIcon">

        <!--
          A framework theme, not the host's: the host's belongs to a resource
          table this activity's views know nothing about, and a module theme
          cannot be referenced from a manifest Stitch merges into the host.
          DayNight follows the system setting, which is close enough to
          WhatsApp's own for a screen of switches.
        -->
        <activity
            android:name="com.smali_generator.ui.PatchSettingsActivity"
            android:exported="false"
            android:label="Patcher"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <activity
            android:name="com.smali_generator.ui.ChatPickerActivity"
            android:exported="false"
            android:label="Read receipts"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <activity
            android:name="com.smali_generator.ui.AbPropsActivity"
            android:exported="false"
            android:label="A/B properties"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <activity
            android:name="com.smali_generator.ui.GroupHistoryActivity"
            android:exported="false"
            android:label="Group history"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <activity
            android:name="com.smali_generator.ui.GroupStatsActivity"
            android:exported="false"
            android:label="Statistics"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <activity
            android:name="com.smali_generator.ui.SharedMembersActivity"
            android:exported="false"
            android:label="Shared members"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <activity
            android:name="com.smali_generator.ui.DriveBackupActivity"
            android:exported="false"
            android:label="Drive backup"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <activity
            android:name="com.smali_generator.ui.DriveRestoreActivity"
            android:exported="false"
            android:label="Restore from Drive"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />

        <!--
          Stitch merges this into WhatsApp's manifest. Verified 2026-09-30: the
          permission and exported attributes survive the merge, and the job runs
          in the host's process with InitProvider already through, so PatchDb is
          open by the time onStartJob runs.
        -->
        <service
            android:name="com.smali_generator.backup.BackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
